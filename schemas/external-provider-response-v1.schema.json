{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adrproof.dev/schemas/external-provider-response-v1.schema.json",
  "title": "ADRProof external fact provider response v1",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "inputs",
    "artifacts",
    "facts",
    "coverage",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "adrproof-external-provider-response-v1"},
    "provider": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/providerId"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/logicalPath"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverage"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "relation": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "logicalPath": {
      "type": "string",
      "pattern": "^(project|spec):[^/\\\\][^\\\\]*$"
    },
    "span": {
      "type": ["object", "null"],
      "required": ["filename", "line", "column"],
      "properties": {
        "filename": {"$ref": "#/$defs/logicalPath"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "source", "span", "extractor"],
      "properties": {
        "kind": {"enum": ["deterministically_extracted", "authoritative"]},
        "source": {"$ref": "#/$defs/logicalPath"},
        "span": {"$ref": "#/$defs/span"},
        "extractor": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["id", "relation", "arguments", "value", "attributes", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "relation": {"$ref": "#/$defs/relation"},
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "value": {"const": true},
        "attributes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {"kind": {"const": "global"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": {"enum": ["schema", "table", "materialized_view", "package"]},
            "name": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "coverageDiagnostic": {
      "type": "object",
      "required": ["reason", "provenance"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "relation",
        "provider",
        "world",
        "scope",
        "qualifiers",
        "statement",
        "diagnostics"
      ],
      "properties": {
        "relation": {"$ref": "#/$defs/relation"},
        "provider": {"$ref": "#/$defs/providerId"},
        "world": {"enum": ["closed", "partial"]},
        "scope": {"$ref": "#/$defs/scope"},
        "qualifiers": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "statement": {"type": "string", "minLength": 1},
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/coverageDiagnostic"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
